diff --git a/custom_subset/input/drivers_joypad/sdl_miyoomini_joypad.c b/input/drivers_joypad/sdl_miyoomini_joypad.c
new file mode 100644
index 0000000..34ced04
--- /dev/null
+++ b/input/drivers_joypad/sdl_miyoomini_joypad.c
@@ -0,0 +1,415 @@
+/*  RetroArch - A frontend for libretro.
+ *  Copyright (C) 2011-2020 - Daniel De Matteis
