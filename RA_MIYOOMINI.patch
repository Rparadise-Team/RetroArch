+static void sdl_miyoomini_set_texture_enable(void *data, bool state, bool full_screen) {
+   sdl_miyoomini_video_t *vid = (sdl_miyoomini_video_t*)data;
+   if (unlikely(!vid)) return;
+
+   if (state == vid->menu_active) return;
