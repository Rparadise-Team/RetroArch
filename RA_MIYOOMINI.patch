+	"	beq 7f			;"
+	"	vldmia %0!, {d30}	;"	// 8 bytes
+	"	vstmia %1!, {d30}	;"
+	"	vstmia r9!, {d30}	;"
+	"	cmp %0, r8		;"
+	"	beq 8f			;"
+	"7:	ldr lr, [%0],#4		;"	// 4 bytes
