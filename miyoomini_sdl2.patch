-//
-//	Rotate 640x480x32bpp surface NEON / for duplicate FB
-//
-void	RotateSurfaceNEON(void* src) {
-	asm volatile (
-	"	add r1,%0,#(640*240*4)	;"
-	"	mov r2,r1		;"
-	"	mov r3,r1		;"
-	"1:	vldmia r1,{q0-q7}	;"
-	"	vrev64.32 d31,d0	;"
-	"	vrev64.32 d30,d1	;"
-	"	vrev64.32 d29,d2	;"
-	"	vrev64.32 d28,d3	;"
-	"	vrev64.32 d27,d4	;"
-	"	vrev64.32 d26,d5	;"
-	"	vrev64.32 d25,d6	;"
-	"	vrev64.32 d24,d7	;"
-	"	vrev64.32 d23,d8	;"
-	"	vrev64.32 d22,d9	;"
-	"	vrev64.32 d21,d10	;"
-	"	vrev64.32 d20,d11	;"
-	"	vrev64.32 d19,d12	;"
-	"	vrev64.32 d18,d13	;"
-	"	vrev64.32 d17,d14	;"
-	"	vrev64.32 d16,d15	;"
-	"	vldmdb r3!,{q0-q7}	;"
-	"	vstmdb r2!,{q8-q15}	;"
-	"	vrev64.32 d31,d0	;"
-	"	vrev64.32 d30,d1	;"
-	"	vrev64.32 d29,d2	;"
-	"	vrev64.32 d28,d3	;"
-	"	vrev64.32 d27,d4	;"
-	"	vrev64.32 d26,d5	;"
-	"	vrev64.32 d25,d6	;"
-	"	vrev64.32 d24,d7	;"
-	"	vrev64.32 d23,d8	;"
-	"	vrev64.32 d22,d9	;"
-	"	vrev64.32 d21,d10	;"
-	"	vrev64.32 d20,d11	;"
-	"	vrev64.32 d19,d12	;"
-	"	vrev64.32 d18,d13	;"
-	"	vrev64.32 d17,d14	;"
-	"	vrev64.32 d16,d15	;"
-	"	vstmia r1!,{q8-q15}	;"
-	"	cmp %0,r2		;"
-	"	bne 1b			"
-	:: "r"(src)
-	: "r1","r2","r3","q0","q1","q2","q3","q4","q5","q6","q7",
-	    "q8","q9","q10","q11","q12","q13","q14","q15","memory","cc"
-	);
-}
-
-void RotateSurface(SDL_Surface *surface)
-{
-    if (!surface || surface->format->BytesPerPixel != 4)
-        return;
-
-    int width = surface->w;
-    int height = surface->h;
-    uint32_t *pixels = (uint32_t *)surface->pixels;
-
-    for (int y = 0; y < height / 2; y++) {
-        for (int x = 0; x < width; x++) {
-            uint32_t topPixel = pixels[y * width + x];
-            uint32_t bottomPixel = pixels[(height - y - 1) * width + (width - x - 1)];
-            pixels[y * width + x] = bottomPixel;
-            pixels[(height - y - 1) * width + (width - x - 1)] = topPixel;
-        }
-    }
-}
